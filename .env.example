# Placeholder providers (use APIs, do not scrape)
# Choose one provider and set its key.
#
# PLACEHOLDER_PROVIDER can be 'unsplash' or 'pexels'
PLACEHOLDER_PROVIDER=unsplash

# Unsplash API
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pexels API
PEXELS_API_KEY=your_pexels_api_key_here

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/dojonet?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT auth
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_BASE64_32"

# Server
PORT=8787
NODE_ENV=development

# Optional: S3-compatible storage
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="dojonet-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
